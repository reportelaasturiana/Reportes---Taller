<!DOCTYPE html><html lang="es"><head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<title>Reportes del Taller · La Asturiana</title>
<link rel="icon" href="logo.png">
<style>
@import url('https://fonts.googleapis.com/css2?family=Montserrat:wght@300;400;500;600;700;800;900&display=swap');
:root{
  --rojo:#c0392b; --rojo-osc:#8a1810; --rojo-prof:#6b0f08;
  --tinta:#1c1a19; --gris:#6b6461; --gris-cl:#a39c99;
  --papel:#faf7f6; --blanco:#fff; --linea:#ece5e3;
}
*{margin:0;padding:0;box-sizing:border-box}
body{font-family:'Montserrat',sans-serif;background:var(--papel);color:var(--tinta);
  -webkit-font-smoothing:antialiased}

.pagina{position:relative;min-height:100vh;min-height:100dvh;display:flex;flex-direction:column;
  overflow:hidden;padding:40px clamp(22px,5vw,64px) 30px}

/* --- textura --- */
.rayas{position:absolute;inset:0;pointer-events:none;
  background-image:repeating-linear-gradient(45deg,
    rgba(192,57,43,.045) 0,rgba(192,57,43,.045) 1px,transparent 1px,transparent 46px)}
.arco{position:absolute;border-radius:50%;pointer-events:none}
.arco-1{width:720px;height:720px;border:92px solid rgba(192,57,43,.05);top:-350px;right:-290px}
.arco-2{width:520px;height:520px;border:64px solid rgba(192,57,43,.04);bottom:-260px;left:-200px}
.rubor{position:absolute;inset:0;pointer-events:none;
  background:radial-gradient(760px 520px at 90% -10%,rgba(192,57,43,.12),transparent 62%),
             radial-gradient(620px 480px at 2% 106%,rgba(192,57,43,.08),transparent 60%)}

/* --- CABECERA: titulo izquierda, semana derecha --- */
.cabecera{position:relative;z-index:5;display:flex;align-items:flex-start;
  justify-content:space-between;gap:28px;flex-wrap:wrap}

.marca{display:inline-flex;align-items:center;gap:12px;background:var(--blanco);
  border:1px solid var(--linea);border-radius:100px;padding:8px 20px 8px 11px;
  box-shadow:0 2px 10px rgba(107,15,8,.05);margin-bottom:26px}
.marca img{height:34px;width:auto;object-fit:contain;display:block}
.marca-txt{line-height:1.25}
.marca-n{font-size:13px;font-weight:800;letter-spacing:-.01em}
.marca-s{font-size:9.5px;font-weight:500;color:var(--gris);letter-spacing:.06em;text-transform:uppercase}

.cintillo{font-size:10px;font-weight:700;letter-spacing:.34em;text-transform:uppercase;
  color:var(--rojo);margin-bottom:11px}
h1{font-size:clamp(30px,5.6vw,52px);font-weight:900;text-transform:uppercase;
  letter-spacing:-.01em;line-height:.96}
h1 .liviano{display:block;font-size:.40em;font-weight:600;letter-spacing:.16em;
  color:var(--gris);margin-bottom:7px}
h1 .rojo{color:var(--rojo)}
.regla{width:50px;height:4px;background:var(--rojo);border-radius:2px;margin-top:20px}

.semana{text-align:right;flex:none;padding-top:6px}
.sem-et{font-size:9.5px;font-weight:700;letter-spacing:.28em;text-transform:uppercase;
  color:var(--gris-cl);margin-bottom:7px}
.sem-n{font-family:'Montserrat',sans-serif;font-size:clamp(22px,3.4vw,32px);font-weight:900;
  color:var(--rojo);line-height:1;letter-spacing:-.01em}
.sem-r{margin-top:8px;font-size:11.5px;font-weight:500;color:var(--gris);max-width:230px;
  margin-left:auto;line-height:1.5}

/* --- CENTRO: las 2 tarjetas, compactas y en una linea --- */
.centro{position:relative;z-index:5;flex:1;display:flex;align-items:center;justify-content:center;
  padding:40px 0}
.fila{display:flex;gap:16px;width:100%;max-width:820px;flex-wrap:wrap}
.tarjeta{position:relative;flex:1 1 300px;display:flex;align-items:center;gap:14px;
  background:var(--blanco);border:1px solid var(--linea);border-radius:14px;
  padding:17px 20px;text-decoration:none;color:var(--tinta);overflow:hidden;
  box-shadow:0 1px 3px rgba(107,15,8,.05),0 8px 24px rgba(107,15,8,.05);
  transition:transform .3s cubic-bezier(.2,1,.3,1),box-shadow .3s,border-color .3s}
.tarjeta::before{content:'';position:absolute;inset:0;opacity:0;
  background:linear-gradient(150deg,var(--rojo) 0%,var(--rojo-osc) 62%,var(--rojo-prof) 100%);
  transition:opacity .3s}
.tarjeta>*{position:relative;z-index:2}
.tarjeta:hover,.tarjeta:focus-visible{transform:translateY(-4px);border-color:transparent;
  box-shadow:0 14px 34px rgba(192,57,43,.26)}
.tarjeta:hover::before,.tarjeta:focus-visible::before{opacity:1}
.tarjeta:focus-visible{outline:3px solid var(--rojo);outline-offset:3px}
.t-ico{font-size:20px;line-height:1;flex:none;transition:transform .3s}
.tarjeta:hover .t-ico{transform:scale(1.1) rotate(-5deg)}
.t-nombre{flex:1;font-size:12.5px;font-weight:800;text-transform:uppercase;
  letter-spacing:.07em;white-space:nowrap;transition:color .3s}
.t-flecha{flex:none;font-size:17px;color:var(--gris-cl);transition:transform .3s,color .3s}
.tarjeta:hover .t-nombre,.tarjeta:focus-visible .t-nombre,
.tarjeta:hover .t-flecha,.tarjeta:focus-visible .t-flecha{color:#fff}
.tarjeta:hover .t-flecha{transform:translateX(4px)}

/* --- PIE --- */
.pie{position:relative;z-index:5;font-size:9.5px;font-weight:600;letter-spacing:.16em;
  text-transform:uppercase;color:var(--gris-cl);border-top:1px solid var(--linea);
  padding-top:16px}

@media(max-width:760px){
  .pagina{padding:30px 20px 24px}
  .cabecera{flex-direction:column;gap:0}
  .semana{text-align:left;padding-top:22px}
  .sem-r{margin-left:0;max-width:none}
  .arco-2{display:none}
  .centro{padding:34px 0}
  .tarjeta{flex:1 1 100%}
  .t-nombre{white-space:normal;font-size:12px}
}
@media(prefers-reduced-motion:reduce){*{transition:none!important}}
</style></head>
<body>
<div class="pagina">
  <div class="rubor"></div>
  <div class="rayas"></div>
  <div class="arco arco-1"></div>
  <div class="arco arco-2"></div>

  <header class="cabecera">
    <div>
      <div class="marca">
        <img src="logo.png" alt="">
        <div class="marca-txt">
          <div class="marca-n">La Asturiana</div>
          <div class="marca-s">Servicios Agrícolas</div>
        </div>
      </div>
      <div class="cintillo">Informe semanal</div>
      <h1><span class="liviano">Reportes del</span><span class="rojo">Taller</span></h1>
      <div class="regla"></div>
    </div>

    <div class="semana">
      <div class="sem-et">Semana</div>
      <div class="sem-n">{{ sem.numero }}</div>
      <div class="sem-r">{{ sem.rango_largo }}</div>
    </div>
  </header>

  <main class="centro">
    <div class="fila">
      <a class="tarjeta" href="Gestion_Taller.html">
        <span class="t-ico">🔧</span>
        <span class="t-nombre">Gestión del Taller</span>
        <span class="t-flecha">→</span>
      </a>
      <a class="tarjeta" href="Reunion_Semanal_Maquinaria.html">
        <span class="t-ico">🚜</span>
        <span class="t-nombre">Reunión Semanal de Maquinaria</span>
        <span class="t-flecha">→</span>
      </a>
    </div>
  </main>

  <footer class="pie">Actualizado: {{ generado_en }}</footer>
</div>
</body></html>
